APP_NAME="Korea Beauty"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kbeauty
DB_USERNAME=postgres
DB_PASSWORD=
# Alternative : une seule DB_URL (ex. Neon) prend le dessus sur les variables ci-dessus.
# Utiliser une connexion directe, jamais un pooler en mode "transaction" (casse les migrations).
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# Alternative : une seule REDIS_URL (fournie automatiquement par Laravel Cloud en prod)
# prend le dessus sur les variables ci-dessous. Laisser vide en local.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@boutique.nfdev.fr"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

LOW_STOCK_THRESHOLD=5

# Adresse recevant les notifications mail natives de Horizon (file d'attente
# bloquee / LongWaitDetected). Laisser vide pour desactiver ce routage - les
# alertes de job en echec (12.11) sont envoyees separement a tous les admins.
HORIZON_ALERT_EMAIL=

# Cloudflare R2 (compatible S3) - stockage des factures en prod.
# En local, INVOICES_DISK=local suffit, ces variables peuvent rester vides.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
INVOICES_DISK=local

# Sauvegardes (spatie/laravel-backup). BACKUP_BUCKET doit etre un bucket R2
# distinct de AWS_BUCKET (factures) - une sauvegarde ne doit pas partager le
# stockage qu'elle est censee pouvoir restaurer. Token R2 dedie, scope
# uniquement sur ce bucket (ne pas reutiliser AWS_ACCESS_KEY_ID/SECRET).
BACKUP_DISK=local
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ALERT_EMAIL=

# Mentions légales affichées sur les factures - à remplir avant la prod.
COMPANY_NAME=
COMPANY_LEGAL_FORM=
COMPANY_ADDRESS_LINE1=
COMPANY_ADDRESS_LINE2=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
COMPANY_COUNTRY=France
COMPANY_SIRET=
COMPANY_VAT_NUMBER=
COMPANY_EMAIL=

CLOUDINARY_URL=

# Clés de test Stripe (dashboard Stripe > Developers > API keys / Webhooks).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (dashboard Cloudflare > Turnstile > widget). TURNSTILE_SITE_KEY
# est publique (exposée au frontend), TURNSTILE_SECRET_KEY ne doit jamais l'être.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Recherche catalogue (Laravel Scout). Sans Meilisearch configuré, Scout retombe sur le
# driver "collection" (recherche en mémoire, sans infra) — suffisant en local/CI.
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# Avis clients (docs/FEATURES.md 14-15) : Klaviyo Reviews (compte Klaviyo > Settings > API Keys)
# et Trustpilot Business (Developer Hub > Apps).
KLAVIYO_PRIVATE_KEY=
KLAVIYO_PUBLIC_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
TRUSTPILOT_API_KEY=
TRUSTPILOT_API_SECRET=
# Adresse BCC unique fournie par Trustpilot (SMA) : Paramètres > Réglages des invitations > SMA.
TRUSTPILOT_INVITATION_BCC=

# Google Tag Manager (tagmanager.google.com > conteneur Web). Chargé uniquement
# si le visiteur accepte les cookies (voir hasMarketingConsent()).
GTM_ID=

# Monitoring d'erreurs (Sentry). DSN identique backend/frontend (projet Sentry
# "Laravel" côté PHP, "React" côté JS) — laisser vide en local desactive l'envoi.
# SENTRY_TRACES_SAMPLE_RATE : 1.0 en dev/staging, reduire en prod si le volume de
# trafic le justifie (cout des quotas Sentry).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Dashboard de sante (spatie/laravel-health, /admin/health) : email de
# reception des alertes en cas de check en echec (DB, Redis, queue, Horizon,
# disque, derniere sauvegarde). Meme compte admin que HORIZON_ALERT_EMAIL.
HEALTH_TO_ADDRESS=

# Microservice pedagogique kbeauty-ai-core-service (Spring Boot, hors depot -
# voir docs/montee-competence/). Optionnel : si injoignable, la page
# diagnostic continue de fonctionner sans l'appel.
AI_CORE_SERVICE_URL=http://localhost:8080

VITE_APP_NAME="${APP_NAME}"
VITE_STRIPE_KEY="${STRIPE_KEY}"
VITE_KLAVIYO_PUBLIC_KEY="${KLAVIYO_PUBLIC_KEY}"
VITE_TRUSTPILOT_BUSINESS_UNIT_ID="${TRUSTPILOT_BUSINESS_UNIT_ID}"
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"
